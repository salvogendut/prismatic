{
  "app-id": "io.github.salvogendut.Prismatic",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.llvm22"],
  "command": "prismatic",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--filesystem=xdg-download",
    "--filesystem=xdg-documents/Prismatic:create",
    "--env=SDL_APP_ID=io.github.salvogendut.Prismatic",
    "--env=SDL_VIDEO_X11_WMCLASS=io.github.salvogendut.Prismatic"
  ],
  "build-options": {
    "strip": false,
    "no-debuginfo": true,
    "append-path": "/app/sdk/rust/bin:/usr/lib/sdk/llvm22/bin",
    "env": {
      "LIBCLANG_PATH": "/usr/lib/sdk/llvm22/lib",
      "LIBCHDMAN_FORCE_SOURCE": "1",
      "LIBCHDMAN_CPU": "portable",
      "CARGO_BUILD_JOBS": "2"
    }
  },
  "cleanup": ["/sdk", "/include", "/lib/pkgconfig", "/lib/cmake", "/share/man", "*.a", "*.la"],
  "modules": [
    {
      "name": "rust-toolchain",
      "buildsystem": "simple",
      "build-commands": [
        "rustc/install.sh --prefix=/app/sdk/rust --disable-ldconfig",
        "cargo/install.sh --prefix=/app/sdk/rust --disable-ldconfig",
        "rust-std/install.sh --prefix=/app/sdk/rust --disable-ldconfig"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://static.rust-lang.org/dist/2026-10-28/rustc-nightly-x86_64-unknown-linux-gnu.tar.xz",
          "sha256": "3e933d06e5a409b882d8e26117ab7b48ce227b50bfc76cc4396b9ab116b5e05c",
          "dest": "rustc"
        },
        {
          "type": "archive",
          "url": "https://static.rust-lang.org/dist/2026-10-28/cargo-nightly-x86_64-unknown-linux-gnu.tar.xz",
          "sha256": "e9b45286785d3a35ddccb5d441b29e3d3a66043d467dfbb4c4d9ed1fd1f9851b",
          "dest": "cargo"
        },
        {
          "type": "archive",
          "url": "https://static.rust-lang.org/dist/2026-10-28/rust-std-nightly-x86_64-unknown-linux-gnu.tar.xz",
          "sha256": "a3d6fbb9c400cf7ba5456e1700036fb303676d6cb4dd7e0cb31eb3ea74c3ece7",
          "dest": "rust-std"
        }
      ]
    },
    {
      "name": "libpcap",
      "buildsystem": "cmake-ninja",
      "config-opts": ["-DBUILD_SHARED_LIBS=ON", "-DCMAKE_INSTALL_LIBDIR=lib", "-DDISABLE_DBUS=ON", "-DDISABLE_USB=ON"],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/the-tcpdump-group/libpcap.git",
          "tag": "libpcap-1.10.5",
          "commit": "bbcbc9174df3298a854daee2b3e666a4b6e5383a"
        }
      ]
    },
    {
      "name": "prismatic",
      "buildsystem": "simple",
      "build-options": {"env": {"CARGO_HOME": "/run/build/prismatic/cargo"}},
      "build-commands": [
        "python3 prismatic/packaging/flatpak/build.py"
      ],
      "sources": [
        {"type": "dir", "path": "prismatic", "dest": "prismatic"},
        {
          "type": "git",
          "url": "https://github.com/salvogendut/iris.git",
          "branch": "xiri",
          "dest": "iris"
        },
        "cargo-sources.json",
        {"type": "file", "path": "build-info.json"}
      ]
    }
  ]
}
